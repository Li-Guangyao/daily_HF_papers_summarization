# Copy to .env for local runs (python -m pipeline.backfill / pipeline.main). Never commit .env.

# LLM provider keys. A provider whose key is missing is simply skipped.
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
ZHIPU_API_KEY=

# Remote D1 (Cloudflare dashboard → My Profile → API Tokens; permission: Account → D1 → Edit).
CF_API_TOKEN=
CF_ACCOUNT_ID=
D1_DATABASE_ID=

# Or use a local SQLite database instead of the remote D1.
# "auto" = the local D1 created by `npm run db:migrate:local` (what `npm run dev:api` serves).
# LOCAL_D1_PATH=auto
